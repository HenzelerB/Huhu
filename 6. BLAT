#!/bin/bash -e

# Purpose: align KisSplice events to the large-larva reference transcriptome.
# Requirements: BLAT and SLURM. Inputs: reference FASTA, then event FASTA.
# Output: Huhu-L1.psl for KisSplice2RefTranscriptome.
# Usage: from the results directory, run: sbatch "6. BLAT"
# Reuse: update reference/query/output paths and -minIdentity.

#SBATCH --cpus-per-task=12
#SBATCH --nodelist=zuse
#SBATCH --job-name=blat
#SBATCH --time=1:00:00

blat -minIdentity=80 ../L_Trinity_CD-HIT.fasta ../results/results_Huhu-L1_trim_Huhu-L1_trim_k41_coherents_type_0a.fa ./Huhu-L1.psl
