#!/bin/bash -e

# Purpose: generate embeddings and predict membrane topology for two protein FASTAs.
# Requirements: TMbed Python environment/model, CUDA GPU, SLURM.
# Inputs: Small_P.fasta and Large_P.fasta. Outputs: matching .h5 and .pred files.
# Usage: activate the TMbed environment, stage FASTAs, then submit with sbatch.
# Reuse: edit the three filename variables per dataset and GPU/SLURM settings.
# Both datasets run in ONE allocation; later #SBATCH directives are ignored.
# Because bash -e is enabled, any failed TMbed command stops the script immediately.

#SBATCH --cpus-per-task=6
#SBATCH --gres=gpu:2
#SBATCH --ntasks=1
#SBATCH --nodelist=marvin
#SBATCH --job-name=17a.TMbed
#SBATCH --time=240:00:00

# Small-larva input and derived outputs.
FASTA_FILE="Small_P.fasta"
EMBEDDINGS_FILE="Small_P.h5"
PREDICTIONS_FILE="Small_P.pred"

export CUBLAS_WORKSPACE_CONFIG=:4096:8
echo "Generating embeddings..."
python -m tmbed embed -f "$FASTA_FILE" -e "$EMBEDDINGS_FILE" --use-gpu
echo "Embeddings saved to $EMBEDDINGS_FILE."
echo "Predicting transmembrane proteins..."
python -m tmbed predict -f "$FASTA_FILE" -e "$EMBEDDINGS_FILE" -p "$PREDICTIONS_FILE" --use-gpu
echo "Predictions saved to $PREDICTIONS_FILE."
echo "Prediction complete. Results:"
cat "$PREDICTIONS_FILE"

#SBATCH --cpus-per-task=6
#SBATCH --gres=gpu:2
#SBATCH --ntasks=1
#SBATCH --nodelist=marvin
#SBATCH --job-name=17b.TMbed
#SBATCH --time=240:00:00

# Large-larva input and derived outputs (same allocation).
FASTA_FILE="Large_P.fasta"
EMBEDDINGS_FILE="Large_P.h5"
PREDICTIONS_FILE="Large_P.pred"

echo "Generating embeddings..."
python -m tmbed embed -f "$FASTA_FILE" -e "$EMBEDDINGS_FILE" --use-gpu
echo "Embeddings saved to $EMBEDDINGS_FILE."
echo "Predicting transmembrane proteins..."
python -m tmbed predict -f "$FASTA_FILE" -e "$EMBEDDINGS_FILE" -p "$PREDICTIONS_FILE" --use-gpu
echo "Predictions saved to $PREDICTIONS_FILE."
echo "Prediction complete. Results:"
cat "$PREDICTIONS_FILE"
