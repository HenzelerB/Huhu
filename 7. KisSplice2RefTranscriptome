#!/bin/bash -e

# Purpose: project KisSplice events onto a reference transcriptome for KissDE.
# Requirements: kisSplice2RefTranscriptome and SLURM.
# Inputs: TransDecoder BED (-b), event FASTA (-k), and BLAT PSL (-t).
# Outputs: main and low-coverage TSVs; -s defines the KissDE prefix.
# Usage: stage the inputs, then: sbatch "7. KisSplice2RefTranscriptome"
# Reuse: replace all sample-specific filenames and output prefixes below.

#SBATCH --cpus-per-task=6
#SBATCH --nodelist=zuse
#SBATCH --job-name=kissplice2reftranscriptome

kissplice2reftranscriptome \
  -b S_Trinity_CD-HIT.fasta.transdecoder.bed \
  -k results_Huhu-S1_trim_Huhu-S1_trim_k41_type_0a.fa \
  -t Huhu-S1.psl \
  -s kissDE_output \
  -o Huhu-S1_mainOutput.tsv \
  -l Huhu-S1_lowQueryCoverageOutput.tsv
