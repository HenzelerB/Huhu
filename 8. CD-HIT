#!/bin/bash -e

# Purpose: cluster redundant transcripts in merged, small-, and large-larva assemblies.
# Requirements: cd-hit-est and SLURM. Inputs: the three Trinity FASTAs below.
# Outputs: three *CD-HIT.fasta files and their cluster metadata files.
# Usage: from the CD-HIT work directory, run: sbatch "8. CD-HIT"
# Reuse: update paths, identity (-c), memory MB (-M), and threads (-T).

#SBATCH --cpus-per-task=20
#SBATCH --job-name=8.CD-HIT
#SBATCH --time=48:00:00

cd-hit-est -i ../3.Trinity/merged/trinity.Trinity.fasta -o Trinity_CD-HIT.fasta -c 0.95 -n 11 -p 1 -g 1 -M 200000 -T 20 -d 0
cd-hit-est -i ../3.Trinity/normalised_reads_S/trinity_S.Trinity.fasta -o S_Trinity_CD-HIT.fasta -c 0.95 -n 11 -p 1 -g 1 -M 200000 -T 20 -d 0
cd-hit-est -i ../3.Trinity/normalised_reads_L/trinity_L.Trinity.fasta -o L_Trinity_CD-HIT.fasta -c 0.95 -n 11 -p 1 -g 1 -M 200000 -T 20 -d 0
