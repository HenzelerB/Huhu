#!/bin/bash -e

# Purpose: search predicted proteins against Swiss-Prot and transcripts against nt.
# Requirements: BLAST+, local swissprot/nt databases, SLURM.
# Inputs: merged/small/large FASTAs and their predicted .pep files.
# Outputs: blastp*.outfmt6 and blastn*.outfmt6 tables with taxonomy fields.
# Usage: stage inputs/databases, then submit this file with sbatch.
# Reuse: update queries, DB paths, e-values, outputs, threads, and resources.
# All commands run in ONE allocation: later #SBATCH blocks do not change resources.
# Split this file into individual scripts if the searches need separate jobs.

#SBATCH --cpus-per-task=32
#SBATCH --job-name=9a.blastp
#SBATCH --nodelist=zuse
#SBATCH --mem=100G

run_blastp() {
    local db=$1
    local output=$2
    blastp -query ./trinity.Trinity.fasta.transdecoder.pep \
           -db "$db" \
           -out "$output" \
           -evalue 1e-5 \
           -num_threads 32 \
           -max_target_seqs 500 \
           -outfmt "6 qseqid sseqid pident length mismatch gapopen evalue bitscore staxids ssciname scomname sskingdoms"
}

run_blastp "./swissprot" "blastp.outfmt6"

